<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} · open-med-mcp</title>
<style>
  :root { color-scheme: dark; }
  body { margin: 0; background: #0f1115; color: #e6e6e6; font: 14px/1.4 system-ui, -apple-system, Segoe UI, Roboto, sans-serif; }
  header { display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; padding: 10px 16px; background: #171a21; border-bottom: 1px solid #262a33; }
  header h1 { font-size: 15px; margin: 0; font-weight: 600; }
  header .meta { color: #9aa3b2; font-size: 12px; }
  main { display: grid; grid-template-columns: 1fr 260px; gap: 16px; padding: 16px; }
  @media (max-width: 800px) { main { grid-template-columns: 1fr; } }
  .stage { position: relative; background: #000; border: 1px solid #262a33; border-radius: 8px; overflow: hidden; display: flex; align-items: center; justify-content: center; min-height: 320px; }
  .stage img { position: absolute; inset: 0; margin: auto; max-width: 100%; max-height: 100%; image-rendering: auto; user-select: none; -webkit-user-drag: none; }
  .stage img.ov { image-rendering: pixelated; pointer-events: none; }
  .stage canvas { position: absolute; inset: 0; margin: auto; pointer-events: none; }
  .panel { display: flex; flex-direction: column; gap: 12px; }
  .card { background: #171a21; border: 1px solid #262a33; border-radius: 8px; padding: 12px; }
  .card h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: #9aa3b2; margin: 0 0 8px; }
  label { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 13px; margin: 6px 0; }
  input[type=range] { width: 130px; }
  .legend span.sw { display: inline-block; width: 12px; height: 12px; border-radius: 2px; margin-right: 6px; vertical-align: -1px; }
  code { background: #0f1115; padding: 2px 5px; border-radius: 4px; font-size: 12px; }
  .hint { color: #9aa3b2; font-size: 12px; }
  kbd { border: 1px solid #3a3f4b; border-bottom-width: 2px; border-radius: 4px; padding: 0 5px; font-size: 11px; }
</style>
</head>
<body>
<header>
  <h1>{{ title }}</h1>
  <span class="meta">{{ plane }} · window {{ window }} · size {{ meta.size_xyz }} · spacing {{ meta.spacing }} mm{% if meta.orientation %} · {{ meta.orientation }}{% endif %} · {{ meta.modality }}</span>
</header>
<main>
  <div class="stage" id="stage">
    <img id="base" alt="slice">
    <img id="ov" class="ov" alt="overlay">
    <canvas id="marker"></canvas>
  </div>
  <div class="panel">
    <div class="card">
      <h2>Slice</h2>
      <label><span>{{ meta.stack_axis }} = <b id="sliceLabel">0</b></span><input type="range" id="slice" min="0" max="{{ n_frames - 1 }}" value="0"></label>
      <div class="hint"><kbd>←</kbd>/<kbd>→</kbd> or mouse wheel to scroll · <kbd>o</kbd> toggles overlay</div>
    </div>
    <div class="card">
      <h2>Overlay</h2>
      <label><span>visible</span><input type="checkbox" id="ovOn" checked></label>
      <label><span>opacity</span><input type="range" id="alpha" min="0" max="1" step="0.05" value="{{ default_alpha }}"></label>
      {% if legend %}<div class="legend">{% for name, color in legend.items() %}<div><span class="sw" style="background: {{ color }}"></span>{{ name }}</div>{% endfor %}</div>{% endif %}
    </div>
    <div class="card">
      <h2>Prompt coordinates</h2>
      <div class="hint">Click on the image to read native voxel coordinates (x, y, z) for prompts. Drag to measure a box.</div>
      <div style="margin-top:8px"><code id="coord">click on the image</code></div>
      <div style="margin-top:6px"><code id="box"></code></div>
    </div>
    <div class="card hint">screen x = {{ meta.col_axis }}, screen y = {{ meta.row_axis }}, slice axis = {{ meta.stack_axis }} · generated by open-med-mcp</div>
  </div>
</main>
<script>
const frames = {{ frames_json | safe }};
const axes = {{ axes | tojson }};
const stage = document.getElementById('stage'), base = document.getElementById('base'), ov = document.getElementById('ov');
const slider = document.getElementById('slice'), sliceLabel = document.getElementById('sliceLabel');
const ovOn = document.getElementById('ovOn'), alpha = document.getElementById('alpha');
const coordEl = document.getElementById('coord'), boxEl = document.getElementById('box');
let cur = 0;
function show(i) {
  cur = Math.max(0, Math.min(frames.length - 1, i));
  const f = frames[cur];
  base.src = 'data:image/jpeg;base64,' + f.img;
  if (f.ov) { ov.src = 'data:image/png;base64,' + f.ov; ov.style.display = ovOn.checked ? '' : 'none'; } else { ov.style.display = 'none'; }
  ov.style.opacity = alpha.value;
  slider.value = cur; sliceLabel.textContent = f.index;
}
function native(ev) {
  const f = frames[cur], r = base.getBoundingClientRect();
  let c = (ev.clientX - r.left) / r.width * f.cols, rr = (ev.clientY - r.top) / r.height * f.rows;
  if (c < 0 || rr < 0 || c >= f.cols || rr >= f.rows) return null;
  if (f.flip_x) c = f.cols - 1 - c; if (f.flip_y) rr = f.rows - 1 - rr;
  const out = [0, 0, 0]; out[axes.col] = Math.floor(c); out[axes.row] = Math.floor(rr); out[axes.stack] = f.index;
  return out;
}
let dragStart = null;
stage.addEventListener('mousedown', ev => { dragStart = native(ev); });
stage.addEventListener('mousemove', ev => { const p = native(ev); if (p) coordEl.textContent = `x=${p[0]}, y=${p[1]}, z=${p[2]}`; });
stage.addEventListener('mouseup', ev => {
  const p = native(ev); if (!p) return;
  if (dragStart && (Math.abs(dragStart[axes.col] - p[axes.col]) > 1 || Math.abs(dragStart[axes.row] - p[axes.row]) > 1)) {
    const lo = dragStart.map((v, i) => Math.min(v, p[i])), hi = dragStart.map((v, i) => Math.max(v, p[i]));
    boxEl.textContent = `{"type": "box", "coords": [${lo[0]}, ${lo[1]}, ${lo[2]}, ${hi[0]}, ${hi[1]}, ${hi[2]}]}`;
  } else {
    boxEl.textContent = `{"type": "point", "coords": [${p[0]}, ${p[1]}, ${p[2]}], "label": 1}`;
  }
  dragStart = null;
});
slider.addEventListener('input', () => show(parseInt(slider.value)));
ovOn.addEventListener('change', () => show(cur));
alpha.addEventListener('input', () => { ov.style.opacity = alpha.value; });
stage.addEventListener('wheel', ev => { ev.preventDefault(); show(cur + (ev.deltaY > 0 ? 1 : -1)); }, { passive: false });
window.addEventListener('keydown', ev => {
  if (ev.key === 'ArrowRight' || ev.key === 'ArrowUp') show(cur + 1);
  else if (ev.key === 'ArrowLeft' || ev.key === 'ArrowDown') show(cur - 1);
  else if (ev.key === 'o') { ovOn.checked = !ovOn.checked; show(cur); }
});
function fit() { const f = frames[cur]; const W = stage.clientWidth, H = Math.max(stage.clientHeight, 320); const s = Math.min(W / f.w, H / f.h); const w = f.w * s, h = f.h * s; for (const el of [base, ov]) { el.style.width = w + 'px'; el.style.height = h + 'px'; } }
base.addEventListener('load', fit); window.addEventListener('resize', fit);
show(frames.length > 1 ? Math.floor(frames.length / 2) : 0);
</script>
</body>
</html>
