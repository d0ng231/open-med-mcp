<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} · OMM viewer</title>
<style>
  :root { color-scheme: dark; --bg:#0d1117; --panel:#161b22; --border:#30363d; --muted:#8b949e; --text:#e6edf3; --teal:#2dd4bf; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font: 14px/1.45 system-ui, -apple-system, Segoe UI, Roboto, sans-serif; }
  header { display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: center; padding: 11px 16px; background: var(--panel); border-bottom: 1px solid var(--border); }
  .brand { display: flex; align-items: center; gap: 9px; font-weight: 700; letter-spacing: .2px; }
  .brand .logo { width: 22px; height: 22px; }
  .brand small { font-weight: 600; color: var(--muted); letter-spacing: .5px; }
  header h1 { font-size: 14px; margin: 0; font-weight: 600; }
  header .meta { color: var(--muted); font-size: 12px; }
  main { display: grid; grid-template-columns: 1fr 272px; gap: 16px; padding: 16px; }
  @media (max-width: 820px) { main { grid-template-columns: 1fr; } }
  .stageWrap { position: relative; background: #05070b; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; min-height: 340px; display: flex; align-items: center; justify-content: center; }
  .stage { position: relative; will-change: transform; }
  .stage img { position: absolute; inset: 0; margin: auto; user-select: none; -webkit-user-drag: none; }
  .stage img.ov { image-rendering: pixelated; pointer-events: none; }
  .stage canvas { position: absolute; inset: 0; margin: auto; pointer-events: none; }
  .cine { position: absolute; left: 10px; bottom: 10px; display: flex; gap: 6px; z-index: 3; }
  .badge { position: absolute; right: 10px; top: 10px; z-index: 3; background: rgba(13,17,23,.72); border: 1px solid var(--border); border-radius: 6px; padding: 3px 8px; font-size: 12px; color: var(--muted); }
  .panel { display: flex; flex-direction: column; gap: 12px; }
  .card { background: var(--panel); border: 1px solid var(--border); border-radius: 10px; padding: 12px; }
  .card h2 { font-size: 11px; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); margin: 0 0 9px; }
  label { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 13px; margin: 7px 0; }
  input[type=range] { width: 136px; accent-color: var(--teal); }
  input[type=checkbox] { accent-color: var(--teal); }
  button { font: inherit; font-size: 12px; color: var(--text); background: #21262d; border: 1px solid var(--border); border-radius: 7px; padding: 5px 10px; cursor: pointer; }
  button:hover { border-color: #4b5563; }
  button.on { background: rgba(45,212,191,.16); border-color: var(--teal); color: #7ff0e2; }
  .row { display: flex; gap: 6px; flex-wrap: wrap; }
  .legend div { display: flex; align-items: center; margin: 3px 0; font-size: 13px; }
  .legend span.sw { display: inline-block; width: 12px; height: 12px; border-radius: 3px; margin-right: 7px; }
  code { display: block; background: #05070b; border: 1px solid var(--border); padding: 7px 9px; border-radius: 6px; font-size: 12px; word-break: break-all; }
  .hint { color: var(--muted); font-size: 12px; }
  kbd { border: 1px solid var(--border); border-bottom-width: 2px; border-radius: 4px; padding: 0 5px; font-size: 11px; background:#05070b; }
  .measure { color: var(--teal); font-weight: 600; }
</style>
</head>
<body>
<header>
  <span class="brand">
    <svg class="logo" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="52" cy="50" r="33" stroke="#33456b" stroke-width="9"/>
      <path d="M20 78 A34 34 0 0 0 85 62" stroke="#2dd4bf" stroke-width="9" stroke-linecap="round"/>
      <path d="M42 58c-9-2-9-16 1-18 5-1 8 3 12 2 8-1 12 14 1 17-6 2-9-.3-14-1Z" fill="#ff6b6b" stroke="#fff" stroke-width="2"/>
    </svg>
    OMM <small>viewer</small>
  </span>
  <h1>{{ title }}</h1>
  <span class="meta">{{ plane }} · window {{ window }} · {{ meta.size_xyz }} · {{ meta.spacing }} mm{% if meta.orientation %} · {{ meta.orientation }}{% endif %} · {{ meta.modality }}</span>
</header>
<main>
  <div class="stageWrap" id="wrap">
    <div class="stage" id="stage">
      <img id="base" alt="slice">
      <img id="ov" class="ov" alt="overlay">
      <canvas id="marker"></canvas>
    </div>
    <div class="cine">
      <button id="play" title="Play/pause cine (space)">▶ cine</button>
    </div>
    <div class="badge"><span id="sliceBadge">–</span></div>
  </div>
  <div class="panel">
    <div class="card">
      <h2>Slice</h2>
      <label><span>{{ meta.stack_axis }} = <b id="sliceLabel">0</b> / {{ n_frames - 1 }}</span><input type="range" id="slice" min="0" max="{{ n_frames - 1 }}" value="0"></label>
      <div class="hint"><kbd>←</kbd><kbd>→</kbd> or wheel scroll · <kbd>space</kbd> cine · <kbd>o</kbd> overlay · <kbd>i</kbd> invert</div>
    </div>
    <div class="card">
      <h2>Overlay</h2>
      <label><span>visible</span><input type="checkbox" id="ovOn" checked></label>
      <label><span>opacity</span><input type="range" id="alpha" min="0" max="1" step="0.05" value="{{ default_alpha }}"></label>
      {% if legend %}<div class="legend">{% for name, color in legend.items() %}<div><span class="sw" style="background: {{ color }}"></span>{{ name }}</div>{% endfor %}</div>{% endif %}
    </div>
    <div class="card">
      <h2>Image</h2>
      <label><span>zoom</span><input type="range" id="zoom" min="1" max="6" step="0.1" value="1"></label>
      <div class="row"><button id="invert">invert</button><button id="reset">reset view</button></div>
      <div class="hint" style="margin-top:6px">drag to pan when zoomed in</div>
    </div>
    <div class="card">
      <h2>Prompt &amp; measure</h2>
      <div class="hint">Click for a native voxel point; drag a box. Coordinates feed straight back into <code style="display:inline;border:0;padding:0;background:none">segment</code>.</div>
      <div style="margin-top:8px"><code id="coord">move over the image…</code></div>
      <div style="margin-top:6px"><code id="box">click or drag on the image</code></div>
      <div style="margin-top:6px" class="measure" id="measure"></div>
      <div class="row" style="margin-top:8px"><button id="copy">copy prompt JSON</button></div>
    </div>
    <div class="card hint">screen x = {{ meta.col_axis }}, screen y = {{ meta.row_axis }}, slice = {{ meta.stack_axis }} · <b style="color:var(--muted)">OMM</b> — Open Medical MCP</div>
  </div>
</main>
<script>
const frames = {{ frames_json | safe }};
const axes = {{ axes | tojson }};
const spacing = {{ meta.spacing | tojson }};
const stage = document.getElementById('stage'), wrap = document.getElementById('wrap');
const base = document.getElementById('base'), ov = document.getElementById('ov');
const slider = document.getElementById('slice'), sliceLabel = document.getElementById('sliceLabel'), sliceBadge = document.getElementById('sliceBadge');
const ovOn = document.getElementById('ovOn'), alpha = document.getElementById('alpha');
const coordEl = document.getElementById('coord'), boxEl = document.getElementById('box'), measureEl = document.getElementById('measure');
const zoomEl = document.getElementById('zoom'), invertBtn = document.getElementById('invert'), resetBtn = document.getElementById('reset');
const playBtn = document.getElementById('play'), copyBtn = document.getElementById('copy');
let cur = 0, zoom = 1, panX = 0, panY = 0, inverted = false, lastPrompt = '';

function applyTransform() { stage.style.transform = `translate(${panX}px, ${panY}px) scale(${zoom})`; base.style.filter = inverted ? 'invert(1)' : ''; }
function show(i) {
  cur = (i + frames.length) % frames.length;
  const f = frames[cur];
  base.src = 'data:image/jpeg;base64,' + f.img;
  if (f.ov) { ov.src = 'data:image/png;base64,' + f.ov; ov.style.display = ovOn.checked ? '' : 'none'; } else { ov.style.display = 'none'; }
  ov.style.opacity = alpha.value;
  slider.value = cur; sliceLabel.textContent = f.index; sliceBadge.textContent = 'slice ' + f.index;
}
function native(ev) {
  const f = frames[cur], r = base.getBoundingClientRect();
  let c = (ev.clientX - r.left) / r.width * f.cols, rr = (ev.clientY - r.top) / r.height * f.rows;
  if (c < 0 || rr < 0 || c >= f.cols || rr >= f.rows) return null;
  if (f.flip_x) c = f.cols - 1 - c; if (f.flip_y) rr = f.rows - 1 - rr;
  const out = [0, 0, 0]; out[axes.col] = Math.floor(c); out[axes.row] = Math.floor(rr); out[axes.stack] = f.index;
  return out;
}
// crosshair
const cv = document.getElementById('marker'), cx = cv.getContext('2d');
function crosshair(ev) {
  const f = frames[cur], r = base.getBoundingClientRect();
  cv.width = base.clientWidth; cv.height = base.clientHeight;
  cx.clearRect(0, 0, cv.width, cv.height);
  const x = ev.clientX - r.left, y = ev.clientY - r.top;
  if (x < 0 || y < 0 || x > r.width || y > r.height) return;
  cx.strokeStyle = 'rgba(45,212,191,.7)'; cx.lineWidth = 1;
  cx.beginPath(); cx.moveTo(x, 0); cx.lineTo(x, cv.height); cx.moveTo(0, y); cx.lineTo(cv.width, y); cx.stroke();
}
let dragStart = null, panStart = null;
stage.addEventListener('mousedown', ev => {
  if (zoom > 1 && ev.shiftKey === false && ev.button === 0 && ev.altKey) { panStart = { x: ev.clientX - panX, y: ev.clientY - panY }; return; }
  dragStart = native(ev);
});
window.addEventListener('mousemove', ev => {
  if (panStart) { panX = ev.clientX - panStart.x; panY = ev.clientY - panStart.y; applyTransform(); return; }
  const p = native(ev); if (p) coordEl.textContent = `voxel  x=${p[0]}  y=${p[1]}  z=${p[2]}`;
  crosshair(ev);
});
window.addEventListener('mouseup', ev => {
  if (panStart) { panStart = null; return; }
  const p = native(ev); if (!p || !dragStart) { dragStart = null; return; }
  if (Math.abs(dragStart[axes.col] - p[axes.col]) > 1 || Math.abs(dragStart[axes.row] - p[axes.row]) > 1) {
    const lo = dragStart.map((v, i) => Math.min(v, p[i])), hi = dragStart.map((v, i) => Math.max(v, p[i]));
    lastPrompt = `{"type": "box", "coords": [${lo[0]}, ${lo[1]}, ${lo[2]}, ${hi[0]}, ${hi[1]}, ${hi[2]}]}`;
    const mm = [0, 1, 2].map(i => ((hi[i] - lo[i]) * (spacing[i] || 1)));
    measureEl.textContent = `box ≈ ${mm[0].toFixed(0)} × ${mm[1].toFixed(0)} × ${mm[2].toFixed(0)} mm`;
  } else {
    lastPrompt = `{"type": "point", "coords": [${p[0]}, ${p[1]}, ${p[2]}], "label": 1}`;
    measureEl.textContent = '';
  }
  boxEl.textContent = lastPrompt; dragStart = null;
});
copyBtn.addEventListener('click', () => {
  if (!lastPrompt) return;
  navigator.clipboard && navigator.clipboard.writeText(lastPrompt);
  copyBtn.textContent = 'copied ✓'; copyBtn.classList.add('on');
  setTimeout(() => { copyBtn.textContent = 'copy prompt JSON'; copyBtn.classList.remove('on'); }, 1200);
});
slider.addEventListener('input', () => show(parseInt(slider.value)));
ovOn.addEventListener('change', () => show(cur));
alpha.addEventListener('input', () => { ov.style.opacity = alpha.value; });
zoomEl.addEventListener('input', () => { zoom = parseFloat(zoomEl.value); if (zoom === 1) { panX = panY = 0; } applyTransform(); });
invertBtn.addEventListener('click', () => { inverted = !inverted; invertBtn.classList.toggle('on', inverted); applyTransform(); });
resetBtn.addEventListener('click', () => { zoom = 1; zoomEl.value = 1; panX = panY = 0; inverted = false; invertBtn.classList.remove('on'); applyTransform(); });
wrap.addEventListener('wheel', ev => { ev.preventDefault(); show(cur + (ev.deltaY > 0 ? 1 : -1)); }, { passive: false });
// cine
let cine = null;
function toggleCine() {
  if (cine) { clearInterval(cine); cine = null; playBtn.textContent = '▶ cine'; playBtn.classList.remove('on'); }
  else { cine = setInterval(() => show(cur + 1), 120); playBtn.textContent = '⏸ cine'; playBtn.classList.add('on'); }
}
playBtn.addEventListener('click', toggleCine);
window.addEventListener('keydown', ev => {
  if (ev.key === 'ArrowRight' || ev.key === 'ArrowUp') show(cur + 1);
  else if (ev.key === 'ArrowLeft' || ev.key === 'ArrowDown') show(cur - 1);
  else if (ev.key === 'o') { ovOn.checked = !ovOn.checked; show(cur); }
  else if (ev.key === 'i') { invertBtn.click(); }
  else if (ev.key === ' ') { ev.preventDefault(); toggleCine(); }
});
function fit() { const f = frames[cur]; const W = wrap.clientWidth, H = Math.max(wrap.clientHeight, 340); const s = Math.min(W / f.w, H / f.h); const w = f.w * s, h = f.h * s; for (const el of [base, ov]) { el.style.width = w + 'px'; el.style.height = h + 'px'; } }
base.addEventListener('load', fit); window.addEventListener('resize', fit);
show(frames.length > 1 ? Math.floor(frames.length / 2) : 0);
applyTransform();
</script>
</body>
</html>
