<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  body { max-width: 960px; margin: 32px auto; padding: 0 20px; font: 15px/1.55 system-ui, -apple-system, Segoe UI, Roboto, sans-serif; color: #1c1e26; background: #fafbfc; }
  h1 { font-size: 26px; border-bottom: 2px solid #e2e5ea; padding-bottom: 8px; }
  h2 { font-size: 19px; margin-top: 32px; }
  table { border-collapse: collapse; margin: 12px 0; font-size: 14px; }
  th, td { border: 1px solid #d9dde3; padding: 6px 10px; text-align: left; }
  th { background: #eef1f5; }
  img { max-width: 100%; border-radius: 6px; border: 1px solid #d9dde3; }
  em { color: #5b6270; }
  code { background: #eef1f5; padding: 1px 5px; border-radius: 4px; font-size: 13px; }
  footer { margin-top: 48px; color: #8a919e; font-size: 12px; border-top: 1px solid #e2e5ea; padding-top: 10px; }
</style>
</head>
<body>
{{ body | safe }}
<footer>open-med-mcp {{ version }} · research use only</footer>
</body>
</html>
